# Copy this file to `.env` in the project root before running the app:
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
#
# `.env` is bundled as a Flutter asset (see pubspec.yaml) and loaded at startup
# via flutter_dotenv in AppConfig.initialize().

# REST API base URL (trailing slash optional; https:// is normalized to http://)
API_BASE_URL=http://172.20.10.2/

# WebSocket base URL for door-to-door live updates (wss:// is normalized to ws://)
WEBSOCKET_URL=ws://172.20.10.2/ws/

# Optional: default admin registration code when the backend expects one
DEFAULT_ADMIN_CODE=
