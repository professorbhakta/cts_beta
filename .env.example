# Copy to `.env` (gitignored). Do not commit secrets.
# Loaded by flutter_dotenv — listed as an asset in pubspec.yaml.
# Store/release builds: use HTTPS + WSS only — never ship lab LAN (see docs/API_AND_ENV.md).

# REST base (trailing / optional). Production: https://…
API_BASE_URL=http://127.0.0.1/

# D2D WebSocket base. Production: wss://…/ws/
WEBSOCKET_URL=ws://127.0.0.1/ws/

# Optional default admin registration code
DEFAULT_ADMIN_CODE=
